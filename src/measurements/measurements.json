        "id": "legacy-navigation",
        "patterns": ["--fui-sidebar-*", "--fui-appshell-header-height"],
        "finalOwner": "22"
      },
      {
        "id": "legacy-type-icon-radius",
        "patterns": [
          "--fui-font-*",
          "--fui-line-height-*",
          "--fui-letter-spacing-*",
          "--fui-icon-*",
          "--fui-radius-*"
        ],
