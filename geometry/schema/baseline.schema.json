{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ui-geometry:v1:baseline",
  "title": "Geometry baseline registry",
  "type": "object",
  "required": ["schemaVersion", "runnerVersion", "baselines"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "runnerVersion": { "type": "integer", "const": 1 },
    "baselines": {
      "type": "array",
      "items": { "$ref": "#/$defs/baseline" }
    }
  },
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "repositoryPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "identity": {
      "type": "object",
      "required": ["provider", "userId", "login"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "userId": { "type": "string", "minLength": 1 },
        "login": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "screenshotSettings": {
      "type": "object",
      "required": ["animations", "caret", "scale", "threshold", "maxDiffPixelRatio"],
      "properties": {
        "animations": { "const": "disabled" },
        "caret": { "const": "hide" },
        "scale": { "const": "css" },
        "threshold": { "const": 0.2 },
        "maxDiffPixelRatio": { "const": 0.001 }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": [
        "runnerLabel",
        "osReleaseSha256",
        "platform",
        "architecture",
        "nodeVersion",
        "playwrightVersion",
        "browserName",
        "browserVersion",
        "fontFiles",
        "deviceScaleFactor",
        "locale",
        "timezoneId",
        "screenshot"
      ],
      "properties": {
        "runnerLabel": { "const": "blacksmith-4vcpu-ubuntu-2404" },
        "osReleaseSha256": { "$ref": "#/$defs/sha256" },
        "platform": { "const": "linux" },
        "architecture": { "const": "x64" },
        "nodeVersion": { "type": "string", "pattern": "^v22\\." },
        "playwrightVersion": { "const": "1.58.2" },
        "browserName": { "const": "chromium" },
        "browserVersion": { "type": "string", "minLength": 1 },
        "fontFiles": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["path", "sha256"],
            "properties": {
              "path": { "$ref": "#/$defs/repositoryPath" },
              "sha256": { "$ref": "#/$defs/sha256" }
            },
            "additionalProperties": false
          }
        },
        "deviceScaleFactor": { "const": 1 },
        "locale": { "const": "en-US" },
        "timezoneId": { "const": "UTC" },
        "screenshot": { "$ref": "#/$defs/screenshotSettings" }
      },
      "additionalProperties": false
    },
    "initialGeneration": {
      "type": "object",
      "required": ["sourceRevision", "generatedBy", "generatedAt", "mode", "predecessor", "diff"],
      "properties": {
        "sourceRevision": { "$ref": "#/$defs/revision" },
        "generatedBy": { "$ref": "#/$defs/identity" },
        "generatedAt": { "$ref": "#/$defs/timestamp" },
        "mode": { "const": "initial" },
        "predecessor": { "type": "null" },
        "diff": { "type": "null" }
      },
      "additionalProperties": false
    },
    "updateGeneration": {
      "type": "object",
      "required": ["sourceRevision", "generatedBy", "generatedAt", "mode", "predecessor", "diff"],
      "properties": {
        "sourceRevision": { "$ref": "#/$defs/revision" },
        "generatedBy": { "$ref": "#/$defs/identity" },
        "generatedAt": { "$ref": "#/$defs/timestamp" },
        "mode": { "const": "update" },
        "predecessor": { "$ref": "#/$defs/repositoryPath" },
        "diff": { "$ref": "#/$defs/repositoryPath" }
      },
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "required": [
        "approvalId",
        "decision",
        "approvedBy",
        "approvedAt",
        "reviewBundleSha256",
        "designDecisionId"
      ],
      "properties": {
        "approvalId": { "type": "string", "minLength": 1 },
        "decision": { "enum": ["approved", "rejected"] },
        "approvedBy": { "$ref": "#/$defs/identity" },
        "approvedAt": { "$ref": "#/$defs/timestamp" },
        "reviewBundleSha256": { "$ref": "#/$defs/sha256" },
        "designDecisionId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "baseline": {
      "type": "object",
      "required": [
        "caseId",
        "pngPath",
        "pngSha256",
        "caseExecutionSha256",
        "storybookTreeSha256",
        "runnerTreeSha256",
        "schemaSetSha256",
        "caseSchemaVersion",
        "runnerVersion",
        "environment",
        "generation",
        "reviewBundleSha256",
        "approval"
      ],
      "properties": {
        "caseId": {
          "type": "string",
          "pattern": "^geometry/[a-z][a-z0-9]*(?:-[a-z0-9]+)*/[a-z][a-z0-9]*(?:-[a-z0-9]+)*/(?:compact|default|relaxed|na)/[a-z0-9]+(?:-[a-z0-9]+)*/(?:light|dark|forced)/[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "pngPath": { "$ref": "#/$defs/repositoryPath" },
        "pngSha256": { "$ref": "#/$defs/sha256" },
        "caseExecutionSha256": { "$ref": "#/$defs/sha256" },
        "storybookTreeSha256": { "$ref": "#/$defs/sha256" },
        "runnerTreeSha256": { "$ref": "#/$defs/sha256" },
        "schemaSetSha256": { "$ref": "#/$defs/sha256" },
        "catalogMapSha256": { "$ref": "#/$defs/sha256" },
        "caseSchemaVersion": { "type": "integer", "const": 1 },
        "runnerVersion": { "type": "integer", "const": 1 },
        "environment": { "$ref": "#/$defs/environment" },
        "generation": {
          "oneOf": [
            { "$ref": "#/$defs/initialGeneration" },
            { "$ref": "#/$defs/updateGeneration" }
          ]
        },
        "reviewBundleSha256": { "$ref": "#/$defs/sha256" },
        "approval": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/approval" }]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "caseId": { "type": "string", "pattern": "/catalog-smoke-1440$" }
            },
            "required": ["caseId"]
          },
          "then": {
            "properties": { "catalogMapSha256": { "$ref": "#/$defs/sha256" } },
            "required": ["catalogMapSha256"]
          },
          "else": { "properties": { "catalogMapSha256": false } }
        }
      ],
      "additionalProperties": false
    }
  }
}
