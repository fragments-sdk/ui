{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ui-geometry:v1:case",
  "title": "Geometry case",
  "type": "object",
  "required": [
    "schemaVersion",
    "caseId",
    "storyId",
    "ownerBrief",
    "executionMode",
    "selectors",
    "scenario",
    "transfer"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "caseId": {
      "type": "string",
      "pattern": "^geometry/[a-z][a-z0-9]*(?:-[a-z0-9]+)*/[a-z][a-z0-9]*(?:-[a-z0-9]+)*/(?:compact|default|relaxed|na)/[a-z0-9]+(?:-[a-z0-9]+)*/(?:light|dark|forced)/[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "storyId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*--[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "ownerBrief": { "type": "string", "pattern": "^[0-9]{2}$" },
    "executionMode": { "enum": ["automated", "manual"] },
    "selectors": {
      "type": "object",
      "required": ["root"],
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
      "properties": {
        "root": { "$ref": "#/$defs/elementSelector" }
      },
      "patternProperties": {
        "^(?!root$)[a-z][a-z0-9]*(?:-[a-z0-9]+)*$": { "$ref": "#/$defs/selector" }
      },
      "additionalProperties": false
    },
    "scenario": { "$ref": "urn:ui-geometry:v1:scenario" },
    "transfer": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/transfer" }]
    }
  },
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "$defs": {
    "selector": {
      "type": "object",
      "required": ["attribute", "value", "kind"],
      "properties": {
        "attribute": { "const": "data-geometry-id" },
        "value": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
        "kind": { "enum": ["element", "baseline-marker"] }
      },
      "additionalProperties": false
    },
    "elementSelector": {
      "type": "object",
      "required": ["attribute", "value", "kind"],
      "properties": {
        "attribute": { "const": "data-geometry-id" },
        "value": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
        "kind": { "const": "element" }
      },
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "required": ["provider", "userId", "login"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "userId": { "type": "string", "minLength": 1 },
        "login": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "transfer": {
      "type": "object",
      "required": [
        "transferDecisionId",
        "fromOwner",
        "toOwner",
        "sourceRevision",
        "decidedBy",
        "decidedAt"
      ],
      "properties": {
        "transferDecisionId": {
          "type": "string",
          "pattern": "^geometry-transfer/[a-z][a-z0-9]*(?:-[a-z0-9]+)*/03-to-[0-9]{2}/v1$"
        },
        "fromOwner": { "const": "03" },
        "toOwner": { "type": "string", "pattern": "^[0-9]{2}$", "not": { "const": "03" } },
        "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "decidedBy": { "$ref": "#/$defs/identity" },
        "decidedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
        }
      },
      "additionalProperties": false
    }
  }
}
